<div class="ring" style="width:@(Size)px;height:@(Size)px">
    <svg width="@Size" height="@Size" viewBox="0 0 @Size @Size" role="img" aria-label="@Label">
        <circle cx="@Fmt(C)" cy="@Fmt(C)" r="@Fmt(R)" fill="none" stroke="var(--ring-track)" stroke-width="@Stroke" />
        <circle cx="@Fmt(C)" cy="@Fmt(C)" r="@Fmt(R)" fill="none" stroke="@Color" stroke-width="@Stroke" stroke-linecap="round"
                stroke-dasharray="@Fmt(Circ)" stroke-dashoffset="@Fmt(Circ * (1 - Math.Clamp(Value, 0, 1)))"
                transform="rotate(-90 @Fmt(C) @Fmt(C))" class="ring-value" />
    </svg>
    <div class="ring-center">@ChildContent</div>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public int Size { get; set; } = 120;
    [Parameter] public int Stroke { get; set; } = 10;
    [Parameter] public string Color { get; set; } = "var(--accent)";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private double C => Size / 2.0;
    private double R => (Size - Stroke) / 2.0;
    private double Circ => 2 * Math.PI * R;
    private static string Fmt(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
